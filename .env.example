# Victron Bluetooth identities (uppercase colon-separated MAC addresses)
VICTRON_SHUNT_MAC=AA:BB:CC:DD:EE:01
VICTRON_SOLAR_MAC=AA:BB:CC:DD:EE:02

# 16-byte Victron advertisement keys, encoded as 32 hexadecimal characters
VICTRON_SHUNT_KEY=00000000000000000000000000000000
VICTRON_SOLAR_KEY=00000000000000000000000000000000

# Optional Meshtastic Victron target behavior
VICTRON_TELEMETRY_INTERVAL_SECONDS=600
VICTRON_MIN_SEND_INTERVAL_SECONDS=60
VICTRON_STALE_AFTER_SECONDS=120
VICTRON_SOC_DELTA_PERCENT=1
VICTRON_VOLTAGE_DELTA_MV=100
VICTRON_CURRENT_DELTA_MA=1000
VICTRON_LOW_SOC_PERCENT=25
VICTRON_LOW_SOC_REARM_PERCENT=30

# House network and encrypted ESPHome API/OTA maintenance credentials
WIFI_SSID=replace-me
WIFI_PASSWORD=replace-with-at-least-12-characters
API_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
OTA_PASSWORD=replace-with-at-least-16-characters

# Shared packet-transport passphrase (32 or more printable characters)
TRANSPORT_KEY=replace-with-a-unique-32-character-passphrase

# Optional 1Password integration. Replace these randomly generated example IDs.
OP_SOLAR_ITEM_ID=j4x4x4xtslnp8l5aze7phlp1ph
OP_SHUNT_ITEM_ID=z9cij5vxs6v2ry6vsucs0svmbn
OP_NETWORK_ITEM_ID=x2wy3tn95s4pnyb0j6jun8ckvv
OP_MAC_FIELD=mac
OP_ENCRYPTION_KEY_FIELD=encryptionKey
OP_WIFI_PASSWORD_FIELD=base station password
OP_WIFI_SSID_FIELD=base station name
# Replace this randomly generated example with the vault containing the Wi-Fi item.
OP_NETWORK_VAULT=Example-14e7a138dfb7
# Required for service accounts; optional for an interactive desktop session.
OP_VAULT=
